    "version": "0.2.0",
    "configurations": [
        {
            "name": "Dev-Debug",
            "request": "launch",
            "type": "dart",
            "program": "apps/lib/main_dev.dart",
            "args": [
                "--flavor",
                "dev",
                "--debug",
                "--target",
                "lib/main_dev.dart"
            ]
        },
        {
            "name": "Dev-Release",
            "request": "launch",
            "type": "dart",
            "program": "apps/lib/main_dev.dart",
            "args": [
                "--flavor",
                "dev",
                "--release",
                "--target",
                "lib/main_dev.dart"
            ]
        },
        {
            "name": "Production",
            "request": "launch",
            "type": "dart",
            "program": "apps/lib/main_prod.dart",
            "args": [
                "--flavor",
                "prod",
                "--debug",
                "--target",
                "lib/main_prod.dart"
            ]
        }
    ]
}